{
  "name": "hydrology-monitor-station-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "release:init": "node scripts/release-pipeline.cjs init-data",
    "release:run": "node scripts/release-pipeline.cjs run",
    "release:retry": "node scripts/release-pipeline.cjs retry",
    "release:status": "node scripts/release-pipeline.cjs status",
    "release:record": "node scripts/release-pipeline.cjs record",
    "release:inject": "node scripts/release-pipeline.cjs inject"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
